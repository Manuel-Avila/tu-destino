PORT=3000

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tudestino

# Genera un valor largo y aleatorio, por ejemplo con:
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_largo
JWT_EXPIRES_IN=7d

# Client ID de OAuth 2.0 de Google (console.cloud.google.com > APIs & Services
# > Credentials > Create OAuth client ID > Web application).
# Debe ser el MISMO valor que VITE_GOOGLE_CLIENT_ID en frontend/.env
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Secreto que usa el Google Form (Apps Script) para avisar cada inscripción confirmada.
# Genera uno largo y aleatorio; debe ser el MISMO que pongas en el script del formulario.
FORMS_WEBHOOK_SECRET=cambia_este_secreto_de_forms

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui
